  <!-- ==================== LOGICA INTERACTIVA JS ==================== -->
  <script>
    // Inicializar Iconos Lucide
    lucide.createIcons();

    // Navegación entre pestañas principales
    function showSection(sectionId) {
      document.querySelectorAll('.content-section').forEach(sec => sec.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
        btn.classList.add('text-slate-600', 'hover:bg-slate-100');
      });

      const activeSec = document.getElementById('sec-' + sectionId);
      const activeTab = document.getElementById('tab-' + sectionId);

      if (activeSec) activeSec.classList.remove('hidden');
      if (activeTab) {
        activeTab.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
        activeTab.classList.remove('text-slate-600', 'hover:bg-slate-100');
      }
      lucide.createIcons();
    }

    // Navegación del Banco de Proyectos
    function showProject(projId) {
      document.querySelectorAll('.project-card').forEach(card => card.classList.add('hidden'));
      document.querySelectorAll('.proj-btn').forEach(btn => {
        btn.classList.remove('bg-emerald-600', 'text-white', 'shadow-md');
        btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });

      const targetCard = document.getElementById('proj-' + projId);
      const targetBtn = document.getElementById('btn-' + projId);

      if (targetCard) targetCard.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.classList.add('bg-emerald-600', 'text-white', 'shadow-md');
        targetBtn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      }
      lucide.createIcons();
    }

    // Copiar Prompt al portapapeles
    function copyPrompt(elementId) {
      const text = document.getElementById(elementId).innerText.replace(/^"|"$/g, '');
      navigator.clipboard.writeText(text).then(() => {
        alert("¡Prompt copiado al portapapeles! Pégalo directamente en Gemini o NotebookLM.");
      }).catch(err => {
        console.error("Error al copiar:", err);
      });
    }

    // Simulador de Proyectos Automático
    function generarIdeaProyecto() {
      const m1 = document.getElementById('sel-mat1').value;
      const m2 = document.getElementById('sel-mat2').value;
      const ctx = document.getElementById('sel-contexto').value;
      const resDiv = document.getElementById('resultado-simulador');

      let titulo = "";
      let pregunta = "";
      let producto = "";
      let detalle = "";

      if (ctx === "Alimentación") {
        titulo = "🍽️ La Lonchera Científica y Creativa de 4°";
        pregunta = `¿Cómo podemos calcular las calorías y nutrientes de nuestros recreos escolares usando ${m1} y comunicar recetas sanas con ${m2}?`;
        producto = "Un recetario escolar ilustrado con degustación de bocadillos saludables y análisis de etiquetas.";
        detalle = `Con ${m1} los niños exploran alimentos y unidades de masa/capacidad; con ${m2} redactan instructivos claros o ilustran afiches de sensibilización.`;
      } else if (ctx === "Agua y Clima") {
        titulo = "💧 Guardianes del Agua y los Ríos de Nuestra Provincia";
        pregunta = `¿Cómo afecta el uso del agua a nuestra provincia y qué artefacto o campaña podemos crear articulando ${m1} y ${m2}?`;
        producto = "Filtro casero con piedras/arena y medidor de lluvia (pluviómetro) escolar con bitácora meteorológica.";
        detalle = `Se relacionan los estados de la materia y el relieve de la provincia con canciones, fábulas o campañas de concientización cívica.`;
      } else if (ctx === "Basura y Reciclaje") {
        titulo = "♻️ Eco-Inventores en Acción";
        pregunta = `¿Qué máquinas o mensajes creativos podemos inventar con ${m1} y ${m2} para transformar los desechos plásticos de la escuela?`;
        producto = "Mural tridimensional de tapitas plásticas y prototipo de palanca para compactar latas/botellas.";
        detalle = `Se une el estudio de máquinas simples y medición de superficies con la expresión artística y los valores de conservación ambiental.`;
      } else {
        titulo = "🎭 El Baúl de las Tradiciones y Leyendas de mi Tierra";
        pregunta = `¿De qué manera podemos investigar los personajes históricos y leyendas de nuestro corregimiento mediante ${m1} y representarlos con ${m2}?`;
        producto = "Teatro de títeres o radioteatro escolar presentado a los niños de primer ciclo.";
        detalle = `Se exploran los acontecimientos históricos y datos geográficos combinándolos con la redacción narrativa de guiones y la expresión teatral.`;
      }

      resDiv.innerHTML = `
        <div class="flex items-start justify-between gap-2 border-b border-teal-200 pb-2">
          <div>
            <span class="text-xs uppercase tracking-wider font-extrabold text-teal-800">Propuesta Generada para Docentes:</span>
            <h4 class="text-base md:text-lg font-black text-slate-900 mt-0.5">${titulo}</h4>
          </div>
          <span class="bg-teal-600 text-white font-bold text-xs px-2.5 py-1 rounded-full">MEDUCA 2026</span>
        </div>
        <p class="text-slate-700"><strong>❓ Pregunta Retadora:</strong> ${pregunta}</p>
        <p class="text-slate-700"><strong>📦 Producto Final Integrado:</strong> ${producto}</p>
        <p class="text-slate-600 bg-white p-2.5 rounded-xl border border-teal-100"><strong>💡 Enfoque Curricular:</strong> ${detalle}</p>
        <div class="pt-1 flex justify-end">
          <button onclick="copiarPropuesta('${titulo}', '${pregunta}', '${producto}')" class="px-3 py-1 bg-teal-200 hover:bg-teal-300 text-teal-900 font-bold rounded-lg text-xs flex items-center gap-1">
            <i data-lucide="clipboard-check" class="w-3.5 h-3.5"></i> Copiar a mi Plan Didáctico
          </button>
        </div>
      `;
      resDiv.classList.remove('hidden');
      lucide.createIcons();
    }

    function copiarPropuesta(t, p, pr) {
      const texto = `PROYECTO: ${t}\nPREGUNTA RETADORA: ${p}\nPRODUCTO FINAL: ${pr}`;
      navigator.clipboard.writeText(texto).then(() => {
        alert("¡Propuesta copiada lista para pegar en tu planificación didáctica!");
      });
    }
  </script>
